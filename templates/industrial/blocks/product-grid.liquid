{% if props.title or props.eyebrow %}
<div class="container" style="margin-bottom: 1.5rem">
  {% if props.eyebrow %}<p class="eyebrow">{{ props.eyebrow | escape }}</p>{% endif %}
  {% if props.title %}<h2>{{ props.title | escape }}</h2>{% endif %}
</div>
{% endif %}
<div class="container">
  <div class="wb-product-grid">
    {% for item in props.items %}
      {% assign tag = 'div' %}
      {% if item.link.href %}{% assign tag = 'a' %}{% endif %}
      {% assign lower_title = item.title | downcase %}
      <{{ tag }} class="product-card" data-product-type="{{ item.title | escape }}" {% if item.link.href %} href="{{ item.link.href }}"{% endif %}>
        <div class="product-card-media">
                  {% if item.image %}
                    {{ item.image | img: width: 640, sizes: '(min-width: 700px) 50vw, 100vw', class: 'product-card-img' }}
                  {% elsif item.title contains 'Elevator' or item.title contains 'elevator' %}
            
            <svg class="product-illustration" viewBox="0 0 400 250" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="140" y="20" width="120" height="210" rx="3" stroke-opacity="0.35"/>
              <line x1="140" y1="90" x2="260" y2="90" stroke-opacity="0.4" stroke-dasharray="4 3"/>
              <line x1="140" y1="160" x2="260" y2="160" stroke-opacity="0.4" stroke-dasharray="4 3"/>
              <rect x="155" y="100" width="90" height="50" rx="3" stroke-width="2.2" stroke-opacity="0.6"/>
              <path d="M170 115 Q175 110, 185 112 L195 110 Q210 108, 220 112 L230 114 Q235 115, 235 118 L235 130 Q235 132, 232 134 L165 134 Q162 132, 162 130 L162 120 Q165 116, 170 115 Z" stroke-opacity="0.5"/>
              <circle cx="178" cy="145" r="4" stroke-width="2"/>
              <circle cx="222" cy="145" r="4" stroke-width="2"/>
              <line x1="200" y1="20" x2="200" y2="5" stroke-opacity="0.4"/>
              <line x1="195" y1="5" x2="205" y2="5" stroke-opacity="0.4"/>
              <line x1="260" y1="125" x2="280" y2="125" stroke-opacity="0.3"/>
              <line x1="280" y1="125" x2="280" y2="230" stroke-opacity="0.3"/>
              <line x1="275" y1="230" x2="285" y2="230" stroke-opacity="0.3"/>
              <circle cx="200" cy="125" r="3" fill="currentColor" stroke="none" opacity="0.4"/>
            </svg>
          {% elsif lower_title contains 'tower' %}
            
            <svg class="product-illustration" viewBox="0 0 400 250" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="150" y="10" width="100" height="230" rx="2" stroke-opacity="0.3"/>
              {% for i in (1..5) %}
                {% assign y_base = 50 %}
                {% assign y_val = y_base | plus: i | times: 38 %}
                <line x1="150" y1="{{ y_val }}" x2="250" y2="{{ y_val }}" stroke-opacity="0.3" stroke-dasharray="3 2"/>
                <rect x="{{ 155 | plus: 5 }}" y="{{ y_val | plus: 3 }}" width="40" height="28" rx="2" stroke-width="2" stroke-opacity="0.45"/>
                <rect x="{{ 205 | plus: 0 }}" y="{{ y_val | plus: 3 }}" width="40" height="28" rx="2" stroke-width="2" stroke-opacity="0.45"/>
              {% endfor %}
              <line x1="130" y1="240" x2="270" y2="240" stroke-width="2" stroke-opacity="0.3"/>
              <line x1="200" y1="10" x2="200" y2="240" stroke-opacity="0.15" stroke-dasharray="2 4"/>
            </svg>
          {% elsif lower_title contains 'shuttle' or lower_title contains 'parkcenter' or lower_title contains 'axispark' or lower_title contains 'layerpark' %}
            
            <svg class="product-illustration" viewBox="0 0 400 250" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="30" y="40" width="340" height="170" rx="2" stroke-opacity="0.25"/>
              <line x1="30" y1="125" x2="370" y2="125" stroke-opacity="0.3" stroke-dasharray="4 3"/>
              {% for i in (1..4) %}
                {% assign xp = 55 | plus: i | times: 70 %}
                <rect x="{{ xp }}" y="55" width="55" height="30" rx="2" stroke-width="2" stroke-opacity="0.4"/>
                <rect x="{{ xp }}" y="135" width="55" height="30" rx="2" stroke-width="2" stroke-opacity="0.4"/>
                <circle cx="{{ xp | plus: 10 }}" cy="{{ 85 }}" r="2" fill="currentColor" stroke="none" opacity="0.3"/>
                <circle cx="{{ xp | plus: 45 }}" cy="{{ 85 }}" r="2" fill="currentColor" stroke="none" opacity="0.3"/>
                <circle cx="{{ xp | plus: 10 }}" cy="{{ 165 }}" r="2" fill="currentColor" stroke="none" opacity="0.3"/>
                <circle cx="{{ xp | plus: 45 }}" cy="{{ 165 }}" r="2" fill="currentColor" stroke="none" opacity="0.3"/>
              {% endfor %}
              <rect x="180" y="115" width="40" height="20" rx="2" stroke-width="2.4" stroke-opacity="0.55"/>
              <line x1="200" y1="105" x2="200" y2="115" stroke-opacity="0.4"/>
              <line x1="195" y1="105" x2="205" y2="105" stroke-opacity="0.4"/>
            </svg>
          {% elsif lower_title contains 'puzzle' %}
            
            <svg class="product-illustration" viewBox="0 0 400 250" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="40" y="30" width="320" height="190" rx="2" stroke-opacity="0.25"/>
              <line x1="40" y1="93" x2="360" y2="93" stroke-opacity="0.3" stroke-dasharray="4 3"/>
              <line x1="40" y1="157" x2="360" y2="157" stroke-opacity="0.3" stroke-dasharray="4 3"/>
              <rect x="55" y="40" width="90" height="48" rx="2" stroke-width="2" stroke-opacity="0.4"/>
              <rect x="155" y="40" width="90" height="48" rx="2" stroke-width="2" stroke-opacity="0.4"/>
              <rect x="255" y="40" width="90" height="48" rx="2" stroke-width="2" stroke-opacity="0.4"/>
              <rect x="55" y="105" width="90" height="48" rx="2" stroke-width="2" stroke-opacity="0.4" stroke-dasharray="6 3"/>
              <rect x="155" y="105" width="90" height="48" rx="2" stroke-width="2" stroke-opacity="0.4"/>
              <rect x="255" y="105" width="90" height="48" rx="2" stroke-width="2" stroke-opacity="0.4" stroke-dasharray="6 3"/>
              <rect x="55" y="168" width="90" height="48" rx="2" stroke-width="2" stroke-opacity="0.4"/>
              <rect x="155" y="168" width="90" height="48" rx="2" stroke-width="2" stroke-opacity="0.4" stroke-dasharray="6 3"/>
              <rect x="255" y="168" width="90" height="48" rx="2" stroke-width="2" stroke-opacity="0.4"/>
              <path d="M100 120 L100 140 M120 130 L80 130" stroke-opacity="0.5" stroke-width="2"/>
            </svg>
          {% elsif lower_title contains 'lateral' or lower_title contains 'universal' %}
            
            <svg class="product-illustration" viewBox="0 0 400 250" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="20" y="50" width="360" height="150" rx="2" stroke-opacity="0.25"/>
              <line x1="180" y1="50" x2="180" y2="200" stroke-opacity="0.2" stroke-dasharray="4 3"/>
              {% for i in (1..3) %}
                {% assign yp = 60 | plus: i | times: 40 %}
                <rect x="30" y="{{ yp }}" width="130" height="30" rx="2" stroke-width="2" stroke-opacity="0.4"/>
                <rect x="200" y="{{ yp }}" width="130" height="30" rx="2" stroke-width="2" stroke-opacity="0.4"/>
                <circle cx="40" cy="{{ yp | plus: 15 }}" r="2" fill="currentColor" stroke="none" opacity="0.3"/>
                <circle cx="150" cy="{{ yp | plus: 15 }}" r="2" fill="currentColor" stroke="none" opacity="0.3"/>
                <circle cx="210" cy="{{ yp | plus: 15 }}" r="2" fill="currentColor" stroke="none" opacity="0.3"/>
                <circle cx="320" cy="{{ yp | plus: 15 }}" r="2" fill="currentColor" stroke="none" opacity="0.3"/>
              {% endfor %}
              <line x1="180" y1="125" x2="200" y2="125" stroke-width="2.5" stroke-opacity="0.5"/>
              <line x1="200" y1="115" x2="200" y2="135" stroke-width="2.5" stroke-opacity="0.5"/>
            </svg>
          {% elsif lower_title contains 'compact' %}
            
            <svg class="product-illustration" viewBox="0 0 400 250" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="80" y="50" width="240" height="150" rx="2" stroke-opacity="0.3"/>
              <line x1="80" y1="125" x2="320" y2="125" stroke-opacity="0.3" stroke-dasharray="4 3"/>
              <rect x="100" y="60" width="200" height="55" rx="3" stroke-width="2.2" stroke-opacity="0.5"/>
              <rect x="100" y="135" width="200" height="55" rx="3" stroke-width="2.2" stroke-opacity="0.5"/>
              <path d="M120 78 Q125 73, 135 75 L150 72 Q170 70, 185 73 L200 75 Q210 76, 210 80 L210 95 Q210 97, 207 99 L120 99 Q117 97, 117 95 L117 82 Z" stroke-opacity="0.4"/>
              <circle cx="135" cy="108" r="3" stroke-width="2"/>
              <circle cx="195" cy="108" r="3" stroke-width="2"/>
              <path d="M120 153 Q125 148, 135 150 L150 147 Q170 145, 185 148 L200 150 Q210 151, 210 155 L210 170 Q210 172, 207 174 L120 174 Q117 172, 117 170 L117 157 Z" stroke-opacity="0.4"/>
              <circle cx="135" cy="183" r="3" stroke-width="2"/>
              <circle cx="195" cy="183" r="3" stroke-width="2"/>
              <line x1="310" y1="125" x2="340" y2="125" stroke-opacity="0.3"/>
              <polygon points="335,120 345,125 335,130" stroke-opacity="0.3"/>
            </svg>
          {% elsif lower_title contains 'multilevel' %}
            
            <svg class="product-illustration" viewBox="0 0 400 250" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="40" y="30" width="320" height="190" rx="2" stroke-opacity="0.25"/>
              <line x1="40" y1="93" x2="360" y2="93" stroke-opacity="0.3" stroke-dasharray="4 3"/>
              <line x1="40" y1="157" x2="360" y2="157" stroke-opacity="0.3" stroke-dasharray="4 3"/>
              <rect x="60" y="40" width="85" height="45" rx="2" stroke-width="2" stroke-opacity="0.4"/>
              <rect x="155" y="40" width="85" height="45" rx="2" stroke-width="2" stroke-opacity="0.4"/>
              <rect x="250" y="40" width="85" height="45" rx="2" stroke-width="2" stroke-opacity="0.4"/>
              <rect x="60" y="105" width="85" height="45" rx="2" stroke-width="2" stroke-opacity="0.4"/>
              <rect x="155" y="105" width="85" height="45" rx="2" stroke-width="2" stroke-opacity="0.4"/>
              <rect x="250" y="105" width="85" height="45" rx="2" stroke-width="2" stroke-opacity="0.4"/>
              <rect x="60" y="168" width="85" height="45" rx="2" stroke-width="2" stroke-opacity="0.4"/>
              <rect x="155" y="168" width="85" height="45" rx="2" stroke-width="2" stroke-opacity="0.4"/>
              <rect x="250" y="168" width="85" height="45" rx="2" stroke-width="2" stroke-opacity="0.4"/>
              <line x1="40" y1="30" x2="40" y2="220" stroke-width="2.5" stroke-opacity="0.4"/>
              <line x1="360" y1="30" x2="360" y2="220" stroke-width="2.5" stroke-opacity="0.4"/>
            </svg>
          {% elsif lower_title contains 'pratica' %}
            
            <svg class="product-illustration" viewBox="0 0 400 250" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="60" y="50" width="280" height="150" rx="2" stroke-opacity="0.25"/>
              <line x1="60" y1="125" x2="340" y2="125" stroke-opacity="0.3" stroke-dasharray="4 3"/>
              <rect x="80" y="60" width="110" height="55" rx="3" stroke-width="2.2" stroke-opacity="0.45"/>
              <rect x="210" y="60" width="110" height="55" rx="3" stroke-width="2.2" stroke-opacity="0.45"/>
              <rect x="80" y="135" width="110" height="55" rx="3" stroke-width="2.2" stroke-opacity="0.45" stroke-dasharray="6 3"/>
              <rect x="210" y="135" width="110" height="55" rx="3" stroke-width="2.2" stroke-opacity="0.45"/>
              <line x1="200" y1="50" x2="200" y2="200" stroke-opacity="0.2" stroke-dasharray="3 4"/>
              <path d="M280 145 L280 175 M300 160 L260 160" stroke-opacity="0.5" stroke-width="2"/>
            </svg>
          {% elsif lower_title contains 'idealift' %}
            
            <svg class="product-illustration" viewBox="0 0 400 250" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="20" y1="125" x2="380" y2="125" stroke-width="2" stroke-opacity="0.35"/>
              <rect x="60" y="75" width="280" height="50" rx="2" stroke-width="2.2" stroke-opacity="0.45"/>
              <rect x="60" y="125" width="280" height="80" rx="2" stroke-width="2.2" stroke-opacity="0.3" stroke-dasharray="6 3"/>
              <path d="M80 90 Q85 85, 95 87 L110 84 Q130 82, 145 85 L160 87 Q170 88, 170 92 L170 107 Q170 109, 167 111 L80 111 Q77 109, 77 107 L77 94 Z" stroke-opacity="0.4"/>
              <circle cx="95" cy="118" r="3" stroke-width="2"/>
              <circle cx="155" cy="118" r="3" stroke-width="2"/>
              <line x1="60" y1="125" x2="60" y2="205" stroke-opacity="0.3" stroke-dasharray="3 2"/>
              <line x1="340" y1="125" x2="340" y2="205" stroke-opacity="0.3" stroke-dasharray="3 2"/>
              <line x1="60" y1="205" x2="340" y2="205" stroke-opacity="0.3" stroke-dasharray="3 2"/>
            </svg>
          {% else %}
            
            <svg class="product-illustration" viewBox="0 0 400 250" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="80" y1="20" x2="80" y2="230" stroke-width="2.5" stroke-opacity="0.4"/>
              <line x1="320" y1="20" x2="320" y2="230" stroke-width="2.5" stroke-opacity="0.4"/>
              <rect x="80" y="45" width="240" height="55" rx="3" stroke-width="2.2" stroke-opacity="0.5"/>
              <rect x="80" y="150" width="240" height="55" rx="3" stroke-width="2.2" stroke-opacity="0.5"/>
              <path d="M110 58 Q115 53, 125 55 L140 52 Q160 50, 175 53 L190 55 Q200 56, 200 60 L200 75 Q200 77, 197 79 L110 79 Q107 77, 107 75 L107 62 Z" stroke-opacity="0.4"/>
              <circle cx="125" cy="88" r="3" stroke-width="2"/>
              <circle cx="185" cy="88" r="3" stroke-width="2"/>
              <path d="M110 163 Q115 158, 125 160 L140 157 Q160 155, 175 158 L190 160 Q200 161, 200 165 L200 180 Q200 182, 197 184 L110 184 Q107 182, 107 180 L107 167 Z" stroke-opacity="0.4"/>
              <circle cx="125" cy="193" r="3" stroke-width="2"/>
              <circle cx="185" cy="193" r="3" stroke-width="2"/>
              <line x1="70" y1="20" x2="330" y2="20" stroke-width="2" stroke-opacity="0.3"/>
              <line x1="70" y1="230" x2="330" y2="230" stroke-width="2" stroke-opacity="0.3"/>
              <line x1="200" y1="100" x2="200" y2="150" stroke-opacity="0.3" stroke-dasharray="3 2"/>
              <polygon points="195,148 205,148 200,156" stroke-opacity="0.4"/>
            </svg>
          {% endif %}
        </div>
        <div class="product-card-body">
          {% if item.brand %}<span class="product-card-brand">{{ item.brand | escape }}</span>{% endif %}
          <h3>{{ item.title | escape }}</h3>
          {% if item.tagline %}<p class="product-card-tagline">{{ item.tagline | escape }}</p>{% endif %}
          {% if item.spec1 or item.spec2 %}
          <div class="product-card-specs">
            {% if item.spec1 %}<span>{{ item.spec1 | escape }}</span>{% endif %}
            {% if item.spec2 %}<span>{{ item.spec2 | escape }}</span>{% endif %}
          </div>
          {% endif %}
          {% if item.link.href %}<span class="product-card-more">View product &rarr;</span>{% endif %}
        </div>
      </{{ tag }}>
    {% endfor %}
  </div>
</div>
