{% slot 'footer.before' %}
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="site-brand" href="/">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="6" y="4" width="20" height="24" rx="1.5" stroke-width="1.8" opacity="0.5"/>
            <line x1="10" y1="10" x2="22" y2="10" stroke-width="2.4"/>
            <line x1="10" y1="20" x2="22" y2="20" stroke-width="2.4"/>
            <circle cx="16" cy="14" r="1.6" fill="currentColor" stroke="none"/>
            <circle cx="16" cy="24" r="1.6" fill="currentColor" stroke="none"/>
          </svg>
        </span>
        <span class="brand-name">{{ site.name | escape }}</span>
      </a>
      {% if site.tagline %}<p class="footer-tagline">{{ site.tagline | escape }}</p>{% endif %}
      <div class="footer-contact">
        <p>{{ brand.address | default: 'United Kingdom' | escape }}</p>
        <p><a href="tel:{{ brand.phoneHref | default: '+441****8800' | escape }}">{{ brand.phone | default: '+44 1926 298800' | escape }}</a></p>
        <p><a href="mailto:{{ brand.email | default: 'info@strongmanlifts.co.uk' | escape }}">{{ brand.email | default: 'info@strongmanlifts.co.uk' | escape }}</a></p>
        <p>{{ brand.hours | default: 'Mon–Fri 8:30am – 4:30pm' | escape }}</p>
      </div>
      <div class="footer-social">{% slot 'footer.social' %}</div>
    </div>
    <div class="footer-menu">{% menu 'footer' %}</div>
  </div>
  <div class="container footer-meta">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ brand.legalName | default: site.name | escape }}. UK distributor for Sanpark & Stolzer.</p>
    <p>Supplied, installed and serviced by Strongman Lifts &mdash; Garage Equipment Association member.</p>
  </div>
</footer>
