<section class="wb-section pad-normal">
  <div class="container w-normal">
    <header class="list-header">
      <p class="eyebrow">Sector guides</p>
      <h1>{{ concept.labelPlural | default: concept.label | escape }}</h1>
      <p class="cat-desc">Every building type has a different constraint. These guides set out what usually decides the specification — and what we would look at first.</p>
    </header>

    <div class="sb-grid cols-3">
      {% for d in docs %}
        <a class="sys-card" href="{{ d.path }}">
          <span class="sys-media">
            {% if d.fields.cover %}{{ d.fields.cover | img: width: 640, sizes: '(max-width: 720px) 92vw, 340px' }}{% endif %}
            <span class="sys-code">Guide</span>
          </span>
          <span class="sys-body">
            <span class="sys-name">{{ d.title | escape }}</span>
            {% if d.fields.lede %}<span class="sys-text">{{ d.fields.lede | escape }}</span>{% endif %}
            {% if d.fields.facts %}
              <span class="sys-specs">
                {% for s in d.fields.facts %}<span class="row"><span class="k">{{ s.label | escape }}</span><span class="v">{{ s.value | escape }}</span></span>{% endfor %}
              </span>
            {% endif %}
            <span class="sys-more">Read the guide →</span>
          </span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
