<div class="footer__item">
  {% if props.title %}<h3 class="footer__heading">{{ props.title | escape }}</h3>{% endif %}
  <ul>
    {% for l in props.links %}
      <li><a href="{{ l.href }}"{% if l.title %} title="{{ l.title | escape }}"{% endif %}>{{ l.label | escape }}</a></li>
    {% endfor %}
  </ul>
</div>
