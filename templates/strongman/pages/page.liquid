{% comment %}
  The default document template: a centred header, then the block region laid
  out on the content grid. Blocks sit in the reading column unless they claim a
  wider track (see `.content__body` in base.css).
{% endcomment %}
<article class="content post">
  <header class="content__header content__narrow anim-hidden">
    <h1 class="content__title">{{ doc.title | escape }}</h1>
    {% if fields.lede %}<p class="content__lede">{{ fields.lede | escape }}</p>{% endif %}
  </header>

  <div class="content__body">
    {% region 'content' %}
  </div>
</article>
