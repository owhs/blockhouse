{
  "name": "blockhouse",
  "version": "1.3.0",
  "description": "Blockhouse — a modular, self-hostable, git-friendly site builder. Live server or flat static export. Runs on Bun, Node, and Cloudflare Workers.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "blockhouse": "bin/blockhouse.mjs"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.1"
  },
  "scripts": {
    "dev": "bun src/cli/index.ts dev --dir ../sites/demo",
    "dev:node": "node --import tsx src/cli/index.ts dev --dir ../sites/demo",
    "seed": "bun src/cli/index.ts seed --dir ../sites/demo",
    "export": "bun src/cli/index.ts export --dir ../sites/demo",
    "test": "bun test tests/",
    "test:node": "node --import tsx --test tests/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "optionalDependencies": {
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0"
  }
}
